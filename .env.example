APP_NAME="Inference Ops Platform"
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://inference:inference@postgres:5432/inference_ops
REDIS_URL=redis://redis:6379/0
REDIS_STREAM=inference.events
API_TOKEN=dev-token
AUTH_ENABLED=true
AUTO_CREATE_TABLES=true
ENABLE_SIMULATOR=true
SIMULATOR_INTERVAL_SECONDS=1.0
INFERENCE_UPSTREAM_URL=http://localhost:11434/v1
INFERENCE_UPSTREAM_API_KEY=ollama
INFERENCE_UPSTREAM_TIMEOUT_SECONDS=120
VITE_API_URL=http://localhost:8000
VITE_API_TOKEN=dev-token
